[Unit]
Description=SmartFridge IoT Device Service
After=network-online.target
Wants=network-online.target

[Service]
# User and Group
User=lemon
Group=lemon

# Absolute path to the backend directory
WorkingDirectory=/home/lemon/iot_cst357/backend

# Use the virtual environment Python interpreter directly
ExecStart=/home/lemon/iot_cst357/backend/venv/bin/python3 iot_code.py

# Auto-restart on failure after 5 seconds
Restart=always
RestartSec=5

# Logging configuration
StandardOutput=inherit
StandardError=inherit
SyslogIdentifier=smartfridge-iot

[Install]
WantedBy=multi-user.target
