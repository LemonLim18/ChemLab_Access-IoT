# ===== ChemLab Access Control - Docker Environment Variables =====
# Copy this file to .env and fill in your actual values
#
# For GCP deployment:
#   1. Update MQTT_BROKER with your GCP VM's external IP
#   2. Update API_URL and WS_URL with your GCP external IP or domain
#   3. Run: docker-compose up -d --build

# ===== MQTT Broker Configuration =====
# GCP MQTT Broker IP (update when IP changes)
MQTT_BROKER=34.45.208.206
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password

# ===== Supabase Configuration =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ===== Frontend API Configuration =====
# Update these with your GCP external IP or domain
# These are baked into frontend at BUILD TIME (not runtime)
API_URL=http://34.45.208.206:8000
WS_URL=ws://34.45.208.206:8000/ws

# ===== Notes =====
# - When GCP IP changes, update MQTT_BROKER, API_URL, and WS_URL
# - Then rebuild: docker-compose up -d --build
# - Backend reads MQTT_BROKER at runtime (container restart is enough)
# - Frontend requires rebuild (API_URL is baked into static files)
