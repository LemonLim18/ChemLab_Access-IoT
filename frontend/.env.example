# ===== Frontend Environment Variables =====
# Copy to .env and fill in your values
#
# IMPORTANT: These are baked into the build at BUILD TIME
# After changing, you MUST rebuild: docker-compose up -d --build
#
# Usage:
#   cp .env.example .env
#   docker-compose up -d --build

# Backend API URL (include http:// and port)
# --- PROXY METHOD (BEST PRACTICE) ---
# Leave these BLANK to use the Nginx Proxy (Internal GCP communication)
API_URL=
WS_URL=

# --- EXTERNAL METHOD ---
# Fill these ONLY if you are NOT using the Nginx proxy
# API_URL=http://BACKEND_EXTERNAL_IP:8000
# WS_URL=ws://BACKEND_EXTERNAL_IP:8000/ws
