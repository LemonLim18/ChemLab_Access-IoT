# ===== Frontend Environment Variables =====
# Copy to .env and fill in your values
#
# IMPORTANT: These are baked into the build at BUILD TIME
# After changing, you MUST rebuild: docker-compose up -d --build
#
# Usage:
#   cp .env.example .env
#   docker-compose up -d --build

# Backend API URL (include http:// and port)
API_URL=http://34.45.208.206:8000

# WebSocket URL (include ws:// and path)
WS_URL=ws://34.45.208.206:8000/ws
